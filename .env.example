APP_NAME="DT Medix"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://dtmedix.test
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This installation is one center. Profile shown on the public site and documents.
CENTER_NAME="DT Medix Diagnostic Center"
CENTER_NAME_BN=
CENTER_ADDRESS=
CENTER_MOBILE=
CENTER_EMAIL=

# Hidden Datatech support login on this server (seeded, never shown in staff lists).
SUPER_ADMIN_NAME="Datatech Support"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Password for the demo tenant users (local and staging only).
DEMO_PASSWORD=
# One-click demo logins on the login page. Local/staging only, ignored in production.
IS_DEMO=false
DEMO_CONTACT_PHONE="+880 1575-888775"

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dtmedix
DB_USERNAME=dtmedix
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=dtmedix

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@datatechbd.com"
MAIL_FROM_NAME="${APP_NAME}"

# Backups (spatie/laravel-backup): encrypted archives.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISK=local

# Inertia SSR (public pages only)
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://ssr:13714

# Reverb (real-time)
REVERB_APP_ID=dtmedix
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# SMS (BdBulkSMS)
BDBULKSMS_URL=https://api.bdbulksms.net/api.php
BDBULKSMS_TOKEN=
SMS_COST_PER_SEGMENT=0.35

# WhatsApp Business Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Payment gateways
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_ENABLED=false
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Cloudflare Turnstile (public booking and OTP forms)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
